# Copy to .env for local experiments. Do not commit .env.
# The live app uses the public Supabase project wired in src/integrations/supabase/client.ts.
# Server-only keys (XAI_API_KEY, STRIPE_SECRET_KEY) belong in Vercel / Supabase secrets, never here.

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Exo Wallet (Privy embedded wallet, TESTNET ONLY). Off unless VITE_MPC_WALLET=1.
VITE_MPC_WALLET=
VITE_PRIVY_APP_ID=cmvbdjdfl00l50fjp0i0vrqxs
