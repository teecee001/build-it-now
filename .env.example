# Copy to .env for local experiments. Do not commit .env.
# The live app uses the public Supabase project wired in src/integrations/supabase/client.ts.
# Server-only keys (XAI_API_KEY, STRIPE_SECRET_KEY) belong in Vercel / Supabase secrets, never here.

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Exo Wallet (Privy embedded wallet, TESTNET ONLY). Off unless VITE_MPC_WALLET=1.
VITE_MPC_WALLET=
VITE_PRIVY_APP_ID=cmvbdjdfl00l50fjp0i0vrqxs

# Server secrets. Set these in Supabase function secrets (and the cron caller), never as VITE_ vars.
# CRON_SECRET: required by check-bill-reminders and check-rate-alerts. If unset they return 503.
# Send it as x-cron-secret or Authorization: Bearer <CRON_SECRET>.
# STRIPE_PRICE_ALLOWLIST: optional comma-separated Stripe price ids allowed besides the Pro price.
CRON_SECRET=
STRIPE_PRICE_ALLOWLIST=

