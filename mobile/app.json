{
  "expo": {
    "name": "ExoSky",
    "slug": "exosky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "exosky",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "ios": {
      "bundleIdentifier": "com.exosky.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "ExoSky uses Face ID to unlock the app.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.exosky.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ExoSky uses Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22C55E"
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "ExoSky uses the camera to scan QR codes for payments and wallet addresses.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ExoSky uses your photos to set your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "exoskytruim-pv",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc1342b6-00a3-4f02-880f-6baa9115e0ff"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cc1342b6-00a3-4f02-880f-6baa9115e0ff"
    }
  }
}
